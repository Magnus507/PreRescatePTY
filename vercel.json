{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "crons": [
    { "path": "/api/cron/expire-chips", "schedule": "0 6 * * *" }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "master": true,
      "preview-*": true
    }
  }
}
