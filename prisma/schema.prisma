  @@index([unitId])
  @@index([createdAt])
}

model OperationReturnEvent {
  id            String          @id @default(cuid())
  returnId      String
  eventType     String
  quantity      Int?
  reason        String?
  referenceType String?
  referenceId   String?
  metadataJson  String?
  createdById   String?
  createdAt     DateTime        @default(now())
  return        OperationReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  createdBy     User?           @relation("OperationReturnEventCreatedBy", fields: [createdById], references: [id])

  @@index([returnId])
  @@index([eventType])
  @@index([createdById])
  @@index([createdAt])
}
