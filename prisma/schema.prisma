generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                       String   @id @default(cuid())
  name                     String
  description              String?
  price                    Float
  image                    String?
  category                 String   @default("general")
  stock                    Int      @default(0)
  productType              String   @default("otro")
  estimatedProductionTime  String?
  requiresPersonalization  Boolean  @default(false)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  corporateOrderItems      CorporateOrderEmployeeItem[]
}

model Account {
  id                   String   @id @default(cuid())
  accountType          String   @default("personal")
  accountName          String?
  ownerUserId          String?
  status               String   @default("active")
  packageId            String?
  maxChipsAllocated    Int      @default(1)
  maxProfilesAllocated Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  package       Package?       @relation(fields: [packageId], references: [id])
  profiles      Profile[]
  users         User[]
  chips         Chip[]
  organizations Organization[]
}

model Package {
  id                       String    @id @default(cuid())
  name                     String    @unique
  slug                     String?   @unique
  maxChips                 Int
  maxProfiles              Int       @default(1)
  price                    Float
  description              String?
  isActive                 Boolean   @default(true)
  accountType              String    @default("personal")
  icon                     String?
  color                    String?
  recommended              Boolean   @default(false)
  displayOrder             Int       @default(0)
  savings                  String?
  allowsFamilyProfiles     Boolean   @default(false)
  allowsOrganizationModule Boolean   @default(false)
  allowsSchoolModule       Boolean   @default(false)
  serviceDurationMonths    Int       @default(24)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  accounts                 Account[]
  orders                   Order[]
}

model User {
  id               String            @id @default(cuid())
  accountId        String?
  email            String            @unique
  phone            String?
  passwordHash     String
  role             String            @default("owner")
  isAdmin          Boolean           @default(false)
  adminRole        String? // "admin", "superadmin", "imprenta" — only set when isAdmin=true
  status           String            @default("active")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lastLoginAt      DateTime?
  mfaSecret        String? // TOTP Secret
  mfaEnabled       Boolean           @default(false)
  deletedAt        DateTime? // Soft delete for compliance
  account          Account?          @relation(fields: [accountId], references: [id])
  profile          Profile?
  chips            Chip[]
  orders           Order[]
  reviewedOrders   Order[]           @relation("OrderAdminReview")
  consent          Consent[]
  appNotifications AppNotification[]
  contacts         Contact[]

  @@index([isAdmin]) // Fast admin filtering
  @@index([phone]) // Support lookup
  @@index([email]) // Login/Audit
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Profile {
  id                      String               @id @default(cuid())
  accountId               String?
  userId                  String?              @unique
  firstName               String
  lastName                String
  displayNamePublic       String?
  birthDate               DateTime?
  sex                     String?
  bloodType               String
  allergies               String               @default("")
  chronicConditions       String               @default("")
  medications             String               @default("")
  additionalNotes         String               @default("")
  isInsured               Boolean              @default(false)
  insuranceProvider       String?
  insurancePolicyNumber   String?
  preferredHospital       String?
  insuranceEmergencyPhone String?
  primaryDoctorName       String?
  primaryDoctorPhone      String?
  showInsuranceProviderPublic Boolean          @default(false)
  showPreferredHospitalPublic  Boolean         @default(false)
  showPrimaryDoctorPublic      Boolean         @default(false)
  showPrimaryDoctorPhonePublic Boolean         @default(false)
  showAdditionalNotesPublic    Boolean         @default(false)
  phone                   String?
  nationalId              String?              @default("")
  address                 String?              @db.Text
  city                    String?
  profileVisibilityStatus String               @default("active")
  photoUrl                String?
  lastScanAt              DateTime?
  lastScanLocation        String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  
  // Profile type: personal, family, corporate
  profileType            String               @default("personal")
  
  account                 Account?             @relation(fields: [accountId], references: [id])
  contacts                ProfileContact[]
  user                    User?                @relation(fields: [userId], references: [id])
  assignedChips           Chip[]
  organizationMembers     OrganizationMember[]
  corporateProfileOf     OrganizationMember?  @relation("CorporateProfileOwner")
  digitalPass             DigitalPass?

  @@index([accountId]) // Dashboard: list profiles per account
  @@index([userId]) // Already unique, but explicit for clarity in joins
  @@index([nationalId]) // Support/Emergency: search by Cedula/ID
}

model Contact {
  id             String   @id @default(cuid())
  userId         String?
  fullName       String
  phone          String
  email          String?
  relationship   String   @default("Familiar")
  notifySms      Boolean  @default(false)
  notifyEmail    Boolean  @default(true)
  notifyWhatsapp Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profiles ProfileContact[]
  user     User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileContact {
  id             String   @id @default(cuid())
  profileId      String
  contactId      String
  relationship   String
  contactType    String   @default("auxilio")
  priorityOrder  Int      @default(1)
  notifySms      Boolean  @default(false)
  notifyEmail    Boolean  @default(true)
  notifyWhatsapp Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([profileId, contactId])
}

model Chip {
  id                String           @id @default(cuid())
  accountId         String?
  assignedProfileId String?
  chipUidInternal   String           @unique @default(cuid())
  serialPublic      String           @unique
  shortCode         String           @unique
  nfcUrl            String
  qrUrl             String
  batchId           String?
  productType       String           @default("sticker_nfc_qr")
  nicheType         String           @default("motorcycle")
  internalLabel     String?          @unique
  chipAlias         String?
  status            String           @default("inventory")
  ownerUserId       String?
  activatedAt       DateTime?
  lastScanAt        DateTime?
  lastScanLocation  String?
  transferLock      Boolean          @default(false)
  serviceStartDate  DateTime?
  serviceEndDate    DateTime?
  serviceStatus     String           @default("active")
  isPhysical        Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  claimTokens       ChipClaimToken[]
  corporateOrderItems CorporateOrderEmployeeItem[]
  scanEvents        ScanEvent[]
  notifications     Notification[]
  owner             User?            @relation(fields: [ownerUserId], references: [id])
  assignedProfile   Profile?         @relation(fields: [assignedProfileId], references: [id])
  account           Account?         @relation(fields: [accountId], references: [id])

  @@index([accountId]) // Dashboard: count active chips per account
  @@index([ownerUserId]) // Activation: find chips by owner
  @@index([status]) // Cron: filter chips by status for expiry job
  @@index([serviceEndDate]) // Cron: filter chips near expiry
}

model Organization {
  id               String  @id @default(cuid())
  accountId        String
  legalName        String
  displayName      String?
  companyCode      String? @unique
  organizationType String  @default("company") // "company", "school", "port", etc.
  taxId            String?
  contactEmail     String?
  contactPhone     String?
  address          String?
  status           String  @default("active")

  // Custom Emergency Buttons (Global for the org)
  emergencyButton1Label String? @default("Brigada Interna")
  emergencyButton1Phone String?
  emergencyButton2Label String? @default("Seguridad Control")
  emergencyButton2Phone String?
  emergencyButton3Label String? @default("Ambulancia / Clínica")
  emergencyButton3Phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account                @relation(fields: [accountId], references: [id])
  members   OrganizationMember[]
  locations OrganizationLocation[]
  orders    Order[]
  publicProfile CorporatePublicProfile?
}

model CorporatePublicProfile {
  id             String   @id @default(cuid())
  organizationId String   @unique
  shortCode      String   @unique
  status         String   @default("draft")

  logoUrl        String?
  displayName    String?
  legalName      String?
  ruc            String?
  foundedYear    Int?
  industry       String?
  description    String?
  slogan         String?

  phone          String?
  whatsapp       String?
  email          String?
  website        String?
  address        String?
  mapUrl         String?
  businessHours  String?

  instagram      String?
  facebook       String?
  linkedin       String?
  tiktok         String?
  xTwitter       String?
  youtube        String?

  mainServices      String?
  mainProducts      String?
  branches          String?
  contactPerson     String?
  contactDepartment String?
  certifications    String?
  licenses          String?
  operationNotice   String?

  securityContactName String?
  securityPhone       String?
  emergencyProcedure  String?
  meetingPoint        String?
  receptionPhone      String?
  corporateWhatsapp   String?

  customEmployeeMessage String?
  showCompanyCode       Boolean @default(false)

  showLogo                Boolean @default(true)
  showDisplayName         Boolean @default(true)
  showLegalName           Boolean @default(false)
  showRuc                 Boolean @default(false)
  showFoundedYear         Boolean @default(false)
  showIndustry            Boolean @default(true)
  showDescription         Boolean @default(true)
  showSlogan              Boolean @default(true)
  showPhone               Boolean @default(false)
  showWhatsapp            Boolean @default(false)
  showEmail               Boolean @default(false)
  showWebsite             Boolean @default(false)
  showAddress             Boolean @default(false)
  showMapUrl              Boolean @default(false)
  showBusinessHours       Boolean @default(false)
  showInstagram           Boolean @default(false)
  showFacebook            Boolean @default(false)
  showLinkedin            Boolean @default(false)
  showTiktok              Boolean @default(false)
  showXTwitter            Boolean @default(false)
  showYoutube             Boolean @default(false)
  showMainServices        Boolean @default(false)
  showMainProducts        Boolean @default(false)
  showBranches            Boolean @default(false)
  showContactPerson       Boolean @default(false)
  showContactDepartment   Boolean @default(false)
  showCertifications      Boolean @default(false)
  showLicenses            Boolean @default(false)
  showOperationNotice     Boolean @default(false)
  showSecurityContactName Boolean @default(false)
  showSecurityPhone       Boolean @default(false)
  showEmergencyProcedure  Boolean @default(false)
  showMeetingPoint        Boolean @default(false)
  showReceptionPhone      Boolean @default(false)
  showCorporateWhatsapp   Boolean @default(false)
  showCustomEmployeeMessage Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationLocation {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  city           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  OrganizationDepartment[]
  members      OrganizationMember[]
}

model OrganizationDepartment {
  id         String   @id @default(cuid())
  locationId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location OrganizationLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  members  OrganizationMember[]
}

model OrganizationMember {
  id             String  @id @default(cuid())
  organizationId String
  profileId      String
  locationId     String?
  departmentId   String?
  corporateProfileId String? @unique

  employeeId   String? // ID de empleado o carnet
  internalCode String? // Código interno adicional
  position     String? // Cargo o Puesto
  shift        String? // Turno (Diurno, Nocturno, Rotativo)

  // Occupational / Industrial Data
  occupationalRisks   String[] @default([]) // ["Trabajo en alturas", "Alta tensión"]
  medicalRestrictions String?  @db.Text // "No levantar >15kg"
  emergencyProtocol   String?  @db.Text // "Asma severa -> administrar inhalador"

  // Corporate Contacts (Specific per member if needed)
  supervisorName  String?
  supervisorPhone String?

  corporateStatus    String  @default("pending_company_review")
  employeeNationalId String?
  employeeAge        Int?
  employeePhone      String?
  employeePosition   String?
  employeeDepartment String?
  employeeInternalId String?
  employeeNote       String?

  memberStatus String   @default("active") // "active", "visitor", "contractor", "suspended"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  corporateProfile Profile?             @relation("CorporateProfileOwner", fields: [corporateProfileId], references: [id])
  location     OrganizationLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  department   OrganizationDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  corporateOrderItems CorporateOrderEmployeeItem[]
}

model ChipClaimToken {
  id             String    @id @default(cuid())
  chipId         String
  activationCode String    @unique
  orderId        String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  chip           Chip      @relation(fields: [chipId], references: [id], onDelete: Cascade)
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model ScanEvent {
  id                 String   @id @default(cuid())
  chipId             String
  profileId          String?
  accountId          String?
  scannedAt          DateTime @default(now())
  sourceType         String   @default("qr")
  ipAddress          String?
  userAgent          String?
  geoLat             Float?
  geoLng             Float?
  geoAccuracy        Float?
  country            String?
  city               String?
  address            String?
  emergencyMode      Boolean  @default(true)
  notificationStatus String   @default("pending")
  rawMetadataJson    String?
  chip               Chip     @relation(fields: [chipId], references: [id], onDelete: Cascade)

  @@index([accountId]) // Dashboard: count total scans per account (AccountStateService)
  @@index([chipId]) // History: list scans per chip
  @@index([scannedAt]) // Analytics: time-range queries
  @@index([country]) // Analytics: geographic distribution
  @@index([city]) // Analytics: city-level insights
}

model Consent {
  id           String    @id @default(cuid())
  accountId    String?
  userId       String?
  profileId    String?
  consentType  String
  textVersion  String
  grantedAt    DateTime  @default(now())
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  evidenceJson String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String   @id @default(cuid())
  accountId     String?
  actorUserId   String?
  entityType    String
  entityId      String
  action        String
  oldValuesJson String?
  newValuesJson String?
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([entityId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id               String    @id @default(cuid())
  chipId           String
  eventId          String
  channel          String
  recipient        String
  status           String    @default("pending")
  providerResponse String?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  chip             Chip      @relation(fields: [chipId], references: [id], onDelete: Cascade)

  @@index([chipId]) // Notification history per chip
  @@index([status]) // Filter pending/failed notifications
}

model Order {
  id                     String    @id @default(cuid())
  orderNumber            String    @unique @default(cuid())
  userId                 String?
  amount                 Float
  currency               String    @default("USD")
  orderStatus            String    @default("pending")
  paymentStatus          String    @default("pending")
  paymentMethod          String    @default("manual")
  adminReviewStatus      String    @default("pending")
  adminReviewedAt        DateTime?
  adminReviewedById      String?
  adminReviewNotes       String?   @db.Text
  provider               String    @default("manual")
  providerReference      String?
  paymentProofUrl        String?
  customerName           String?
  customerEmail          String?
  customerPhone          String?
  customerDocument       String?
  shippingAddress        String?   @db.Text
  shippingCity           String?
  shippingNotes          String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  manualPaymentReference String?
  organizationId         String?
  orderType              String    @default("manual")
  
  // Corporate delivery tracking (only for corporate_employee_purchase)
  corporateDeliveryStatus String?
  estimatedDeliveryDate  DateTime?
  deliveryNote           String?   @db.Text

  packageId       String?
  package         Package?         @relation(fields: [packageId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  adminReviewedBy User?            @relation("OrderAdminReview", fields: [adminReviewedById], references: [id])
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  items           OrderItem[]
  corporateEmployeeItems CorporateOrderEmployeeItem[]
  chipClaimTokens ChipClaimToken[]
  // Stripe idempotency is enforced by a partial unique index on
  // (provider, providerReference) where provider='stripe' in the SQL migration.

  @@index([userId])
  @@index([adminReviewedById])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([packageId])
  @@index([organizationId])
  @@index([orderType])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productType String
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model CorporateOrderEmployeeItem {
  id                   String             @id @default(cuid())
  orderId              String
  organizationMemberId String
  productId            String
  chipId               String?
  fulfillmentStatus    String             @default("pending_assignment")
  activatedAt          DateTime?
  quantity             Int                @default(1)
  unitPrice            Float
  subtotal             Float
  createdAt            DateTime           @default(now())

  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  product            Product            @relation(fields: [productId], references: [id])
  chip               Chip?              @relation(fields: [chipId], references: [id])

  @@index([orderId])
  @@index([organizationMemberId])
  @@index([productId])
  @@index([chipId])
  @@index([fulfillmentStatus])
}

model DigitalPass {
  id           String   @id @default(cuid())
  profileId    String   @unique
  passType     String // "apple" or "google"
  passUrl      String?
  serialNumber String?  @unique
  authToken    String?
  lastUpdate   DateTime @default(now())
  createdAt    DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model AppNotification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
