generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String    @id @default(cuid())
  accountType       String    @default("personal")
  accountName       String?
  ownerUserId       String?
  status            String    @default("active")
  packageId         String?
  maxChipsAllocated Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  package           Package?  @relation(fields: [packageId], references: [id])
  profiles          Profile[]
  users             User[]
  chips             Chip[]
  organizations     Organization[]
}

model Package {
  id          String    @id @default(cuid())
  name        String    @unique
  maxChips    Int
  price       Float
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  accounts    Account[]
}

model User {
  id           String    @id @default(cuid())
  accountId    String?
  email        String    @unique
  phone        String?
  passwordHash String
  role         String    @default("owner")
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  account      Account?  @relation(fields: [accountId], references: [id])
  profile      Profile?
  chips        Chip[]
  orders       Order[]
  consent      Consent[]
}

model Profile {
  id                      String             @id @default(cuid())
  accountId               String?
  userId                  String?            @unique
  firstName               String
  lastName                String
  displayNamePublic       String?
  birthDate               String?
  sex                     String?
  bloodType               String
  allergies               String             @default("")
  chronicConditions       String             @default("")
  medications             String             @default("")
  additionalNotes         String             @default("")
  profileVisibilityStatus String             @default("active")
  photoUrl                String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  account                 Account?           @relation(fields: [accountId], references: [id])
  emergencyContacts       EmergencyContact[]
  user                    User?              @relation(fields: [userId], references: [id])
  assignedChips           Chip[]
  organizationMembers     OrganizationMember[]
}

model EmergencyContact {
  id             String   @id @default(cuid())
  userId         String?
  profileId      String?
  fullName       String
  relationship   String
  phone          String
  email          String?
  priorityOrder  Int      @default(1)
  notifySms      Boolean  @default(false)
  notifyEmail    Boolean  @default(true)
  notifyWhatsapp Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  profile        Profile? @relation(fields: [profileId], references: [id])
}

model Chip {
  id                String    @id @default(cuid())
  accountId         String?
  assignedProfileId String?
  chipUidInternal   String    @unique @default(cuid())
  serialPublic      String    @unique
  shortCode         String    @unique
  nfcUrl            String
  qrUrl             String
  batchId           String?
  productType       String    @default("sticker_nfc_qr")
  nicheType         String    @default("motorcycle")
  status            String    @default("inventory")
  ownerUserId       String?
  activatedAt       DateTime?
  lastScanAt        DateTime?
  transferLock      Boolean   @default(false)
  serviceStartDate  DateTime?
  serviceEndDate    DateTime?
  serviceStatus     String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  claimTokens       ChipClaimToken[]
  scanEvents        ScanEvent[]
  notifications     Notification[]
  owner             User?     @relation(fields: [ownerUserId], references: [id])
  assignedProfile   Profile?  @relation(fields: [assignedProfileId], references: [id])
  account           Account?  @relation(fields: [accountId], references: [id])
}

model Organization {
  id               String   @id @default(cuid())
  accountId        String
  legalName        String
  displayName      String?
  organizationType String   @default("company")
  taxId            String?
  contactEmail     String?
  contactPhone     String?
  address          String?
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  account          Account  @relation(fields: [accountId], references: [id])
  members          OrganizationMember[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  profileId      String
  internalCode   String?
  department     String?
  position       String?
  memberStatus   String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  profile        Profile      @relation(fields: [profileId], references: [id])
}

model ChipClaimToken {
  id             String    @id @default(cuid())
  chipId         String
  activationCode String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  chip           Chip      @relation(fields: [chipId], references: [id])
}

model ScanEvent {
  id                 String   @id @default(cuid())
  chipId             String
  profileId          String?
  accountId          String?
  scannedAt          DateTime @default(now())
  sourceType         String   @default("qr")
  ipAddress          String?
  userAgent          String?
  geoLat             Float?
  geoLng             Float?
  geoAccuracy        Float?
  country            String?
  city               String?
  emergencyMode      Boolean  @default(true)
  notificationStatus String   @default("pending")
  rawMetadataJson    String?
  chip               Chip     @relation(fields: [chipId], references: [id])
}

model Consent {
  id           String    @id @default(cuid())
  accountId    String?
  userId       String?
  profileId    String?
  consentType  String
  textVersion  String
  grantedAt    DateTime  @default(now())
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  evidenceJson String?
  user         User?     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  accountId     String?
  actorUserId   String?
  entityType    String
  entityId      String
  action        String
  oldValuesJson String?
  newValuesJson String?
  createdAt     DateTime @default(now())
}

model Notification {
  id               String    @id @default(cuid())
  chipId           String
  eventId          String
  channel          String
  recipient        String
  status           String    @default("pending")
  providerResponse String?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  chip             Chip      @relation(fields: [chipId], references: [id])
}

model Order {
  id                String   @id @default(cuid())
  userId            String?
  amount            Float
  currency          String   @default("USD")
  paymentStatus     String   @default("pending")
  provider          String   @default("manual")
  providerReference String?
  createdAt         DateTime @default(now())
  user              User?    @relation(fields: [userId], references: [id])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  status       String   @default("active")
  createdAt    DateTime @default(now())
}
