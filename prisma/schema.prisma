generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  image       String?
  category    String   @default("general")
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Account {
  id                   String   @id @default(cuid())
  accountType          String   @default("personal")
  accountName          String?
  ownerUserId          String?
  status               String   @default("active")
  packageId            String?
  maxChipsAllocated    Int      @default(1)
  maxProfilesAllocated Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  package       Package?       @relation(fields: [packageId], references: [id])
  profiles      Profile[]
  users         User[]
  chips         Chip[]
  organizations Organization[]
}

model Package {
  id                       String    @id @default(cuid())
  name                     String    @unique
  slug                     String?   @unique
  maxChips                 Int
  maxProfiles              Int       @default(1)
  price                    Float
  description              String?
  isActive                 Boolean   @default(true)
  accountType              String    @default("personal")
  icon                     String?
  color                    String?
  recommended              Boolean   @default(false)
  displayOrder             Int       @default(0)
  savings                  String?
  allowsFamilyProfiles     Boolean   @default(false)
  allowsOrganizationModule Boolean   @default(false)
  allowsSchoolModule       Boolean   @default(false)
  serviceDurationMonths    Int       @default(24)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  accounts                 Account[]
  orders                   Order[]
}

model User {
  id               String            @id @default(cuid())
  accountId        String?
  email            String            @unique
  phone            String?
  passwordHash     String
  role             String            @default("owner")
  isAdmin          Boolean           @default(false)
  adminRole        String? // "admin", "superadmin", "imprenta" — only set when isAdmin=true
  status           String            @default("active")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lastLoginAt      DateTime?
  mfaSecret        String? // TOTP Secret
  mfaEnabled       Boolean           @default(false)
  deletedAt        DateTime? // Soft delete for compliance
  account          Account?          @relation(fields: [accountId], references: [id])
  profile          Profile?
  chips            Chip[]
  orders           Order[]
  reviewedOrders   Order[]           @relation("OrderAdminReview")
  consent          Consent[]
  appNotifications AppNotification[]
  contacts         Contact[]

  @@index([isAdmin]) // Fast admin filtering
  @@index([phone]) // Support lookup
  @@index([email]) // Login/Audit
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Profile {
  id                      String               @id @default(cuid())
  accountId               String?
  userId                  String?              @unique
  firstName               String
  lastName                String
  displayNamePublic       String?
  birthDate               DateTime?
  sex                     String?
  bloodType               String
  allergies               String               @default("")
  chronicConditions       String               @default("")
  medications             String               @default("")
  additionalNotes         String               @default("")
  phone                   String?
  nationalId              String?              @default("")
  address                 String?              @db.Text
  city                    String?
  profileVisibilityStatus String               @default("active")
  photoUrl                String?
  lastScanAt              DateTime?
  lastScanLocation        String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  account                 Account?             @relation(fields: [accountId], references: [id])
  contacts                ProfileContact[]
  user                    User?                @relation(fields: [userId], references: [id])
  assignedChips           Chip[]
  organizationMembers     OrganizationMember[]
  digitalPass             DigitalPass?

  @@index([accountId]) // Dashboard: list profiles per account
  @@index([userId]) // Already unique, but explicit for clarity in joins
  @@index([nationalId]) // Support/Emergency: search by Cedula/ID
}

model Contact {
  id             String   @id @default(cuid())
  userId         String?
  fullName       String
  phone          String
  email          String?
  relationship   String   @default("Familiar")
  notifySms      Boolean  @default(false)
  notifyEmail    Boolean  @default(true)
  notifyWhatsapp Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profiles ProfileContact[]
  user     User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileContact {
  id             String   @id @default(cuid())
  profileId      String
  contactId      String
  relationship   String
  contactType    String   @default("auxilio")
  priorityOrder  Int      @default(1)
  notifySms      Boolean  @default(false)
  notifyEmail    Boolean  @default(true)
  notifyWhatsapp Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([profileId, contactId])
}

model Chip {
  id                String           @id @default(cuid())
  accountId         String?
  assignedProfileId String?
  chipUidInternal   String           @unique @default(cuid())
  serialPublic      String           @unique
  shortCode         String           @unique
  nfcUrl            String
  qrUrl             String
  batchId           String?
  productType       String           @default("sticker_nfc_qr")
  nicheType         String           @default("motorcycle")
  internalLabel     String?          @unique
  chipAlias         String?
  status            String           @default("inventory")
  ownerUserId       String?
  activatedAt       DateTime?
  lastScanAt        DateTime?
  lastScanLocation  String?
  transferLock      Boolean          @default(false)
  serviceStartDate  DateTime?
  serviceEndDate    DateTime?
  serviceStatus     String           @default("active")
  isPhysical        Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  claimTokens       ChipClaimToken[]
  scanEvents        ScanEvent[]
  notifications     Notification[]
  owner             User?            @relation(fields: [ownerUserId], references: [id])
  assignedProfile   Profile?         @relation(fields: [assignedProfileId], references: [id])
  account           Account?         @relation(fields: [accountId], references: [id])

  @@index([accountId]) // Dashboard: count active chips per account
  @@index([ownerUserId]) // Activation: find chips by owner
  @@index([status]) // Cron: filter chips by status for expiry job
  @@index([serviceEndDate]) // Cron: filter chips near expiry
}

model Organization {
  id               String  @id @default(cuid())
  accountId        String
  legalName        String
  displayName      String?
  organizationType String  @default("company") // "company", "school", "port", etc.
  taxId            String?
  contactEmail     String?
  contactPhone     String?
  address          String?
  status           String  @default("active")

  // Custom Emergency Buttons (Global for the org)
  emergencyButton1Label String? @default("Brigada Interna")
  emergencyButton1Phone String?
  emergencyButton2Label String? @default("Seguridad Control")
  emergencyButton2Phone String?
  emergencyButton3Label String? @default("Ambulancia / Clínica")
  emergencyButton3Phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account                @relation(fields: [accountId], references: [id])
  members   OrganizationMember[]
  locations OrganizationLocation[]
}

model OrganizationLocation {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  city           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  OrganizationDepartment[]
  members      OrganizationMember[]
}

model OrganizationDepartment {
  id         String   @id @default(cuid())
  locationId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location OrganizationLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  members  OrganizationMember[]
}

model OrganizationMember {
  id             String  @id @default(cuid())
  organizationId String
  profileId      String
  locationId     String?
  departmentId   String?

  employeeId   String? // ID de empleado o carnet
  internalCode String? // Código interno adicional
  position     String? // Cargo o Puesto
  shift        String? // Turno (Diurno, Nocturno, Rotativo)

  // Occupational / Industrial Data
  occupationalRisks   String[] @default([]) // ["Trabajo en alturas", "Alta tensión"]
  medicalRestrictions String?  @db.Text // "No levantar >15kg"
  emergencyProtocol   String?  @db.Text // "Asma severa -> administrar inhalador"

  // Corporate Contacts (Specific per member if needed)
  supervisorName  String?
  supervisorPhone String?

  memberStatus String   @default("active") // "active", "visitor", "contractor", "suspended"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  location     OrganizationLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  department   OrganizationDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
}

model ChipClaimToken {
  id             String    @id @default(cuid())
  chipId         String
  activationCode String    @unique
  orderId        String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  chip           Chip      @relation(fields: [chipId], references: [id], onDelete: Cascade)
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model ScanEvent {
  id                 String   @id @default(cuid())
  chipId             String
  profileId          String?
  accountId          String?
  scannedAt          DateTime @default(now())
  sourceType         String   @default("qr")
  ipAddress          String?
  userAgent          String?
  geoLat             Float?
  geoLng             Float?
  geoAccuracy        Float?
  country            String?
  city               String?
  address            String?
  emergencyMode      Boolean  @default(true)
  notificationStatus String   @default("pending")
  rawMetadataJson    String?
  chip               Chip     @relation(fields: [chipId], references: [id], onDelete: Cascade)

  @@index([accountId]) // Dashboard: count total scans per account (AccountStateService)
  @@index([chipId]) // History: list scans per chip
  @@index([scannedAt]) // Analytics: time-range queries
  @@index([country]) // Analytics: geographic distribution
  @@index([city]) // Analytics: city-level insights
}

model Consent {
  id           String    @id @default(cuid())
  accountId    String?
  userId       String?
  profileId    String?
  consentType  String
  textVersion  String
  grantedAt    DateTime  @default(now())
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  evidenceJson String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String   @id @default(cuid())
  accountId     String?
  actorUserId   String?
  entityType    String
  entityId      String
  action        String
  oldValuesJson String?
  newValuesJson String?
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([entityId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id               String    @id @default(cuid())
  chipId           String
  eventId          String
  channel          String
  recipient        String
  status           String    @default("pending")
  providerResponse String?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  chip             Chip      @relation(fields: [chipId], references: [id], onDelete: Cascade)

  @@index([chipId]) // Notification history per chip
  @@index([status]) // Filter pending/failed notifications
}

model Order {
  id                     String    @id @default(cuid())
  orderNumber            String    @unique @default(cuid())
  userId                 String?
  amount                 Float
  currency               String    @default("USD")
  orderStatus            String    @default("pending")
  paymentStatus          String    @default("pending")
  paymentMethod          String    @default("manual")
  adminReviewStatus      String    @default("pending")
  adminReviewedAt        DateTime?
  adminReviewedById      String?
  adminReviewNotes       String?   @db.Text
  provider               String    @default("manual")
  providerReference      String?
  paymentProofUrl        String?
  customerName           String?
  customerEmail          String?
  customerPhone          String?
  customerDocument       String?
  shippingAddress        String?   @db.Text
  shippingCity           String?
  shippingNotes          String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  manualPaymentReference String?

  packageId       String?
  package         Package?         @relation(fields: [packageId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  adminReviewedBy User?            @relation("OrderAdminReview", fields: [adminReviewedById], references: [id])
  items           OrderItem[]
  chipClaimTokens ChipClaimToken[]
  // Stripe idempotency is enforced by a partial unique index on
  // (provider, providerReference) where provider='stripe' in the SQL migration.

  @@index([userId])
  @@index([adminReviewedById])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([packageId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productType String
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model DigitalPass {
  id           String   @id @default(cuid())
  profileId    String   @unique
  passType     String // "apple" or "google"
  passUrl      String?
  serialNumber String?  @unique
  authToken    String?
  lastUpdate   DateTime @default(now())
  createdAt    DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model AppNotification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
