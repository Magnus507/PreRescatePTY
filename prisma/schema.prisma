generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                      String                        @id @default(cuid())
  name                    String
  description             String?
  price                   Float
  image                   String?
  category                String                        @default("general")
  stock                   Int                           @default(0)
  isActive                Boolean                       @default(true)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  productType             String                        @default("otro")
  estimatedProductionTime String?
  requiresPersonalization Boolean                       @default(false)
  corporateOrderItems     CorporateOrderEmployeeItem[]
  productRequestItems     CorporateProductRequestItem[]
}

model Account {
  id                   String         @id @default(cuid())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  accountName          String?
  accountType          String         @default("personal")
  maxChipsAllocated    Int            @default(1)
  maxProfilesAllocated Int            @default(1)
  ownerUserId          String?
  packageId            String?
  status               String         @default("active")
  package              Package?       @relation(fields: [packageId], references: [id])
  chips                Chip[]
  organizations        Organization[]
  profiles             Profile[]
  users                User[]
}

model Package {
  id                       String    @id @default(cuid())
  name                     String    @unique
  slug                     String?   @unique
  maxChips                 Int
  maxProfiles              Int       @default(1)
  price                    Float
  description              String?
  isActive                 Boolean   @default(true)
  accountType              String    @default("personal")
  icon                     String?
  color                    String?
  recommended              Boolean   @default(false)
  displayOrder             Int       @default(0)
  savings                  String?
  allowsFamilyProfiles     Boolean   @default(false)
  allowsOrganizationModule Boolean   @default(false)
  allowsSchoolModule       Boolean   @default(false)
  serviceDurationMonths    Int       @default(24)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  accounts                 Account[]
  orders                   Order[]
}

model User {
  id                          String                          @id @default(cuid())
  accountId                   String?
  email                       String                          @unique
  phone                       String?
  passwordHash                String
  role                        String                          @default("owner")
  status                      String                          @default("active")
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  lastLoginAt                 DateTime?
  adminRole                   String?
  isAdmin                     Boolean                         @default(false)
  deletedAt                   DateTime?
  mfaEnabled                  Boolean                         @default(false)
  mfaSecret                   String?
  appNotifications            AppNotification[]
  chips                       Chip[]
  consent                     Consent[]
  contacts                    Contact[]
  reviewedRequests            CorporateProductRequest[]       @relation("CorporateProductRequestReviewedBy")
  productRequests             CorporateProductRequest[]       @relation("CorporateProductRequestRequestedBy")
  operationMaterialEvents     OperationMaterialEvent[]        @relation("OperationMaterialEventCreatedBy")
  operationProductionEvents   OperationProductionEvent[]      @relation("OperationProductionEventCreatedBy")
  operationQcEvents           OperationQcInspectionEvent[]    @relation("OperationQcInspectionEventCreatedBy")
  operationPackingEvents      OperationPackingEvent[]         @relation("OperationPackingEventCreatedBy")
  operationFinishedGoodEvents OperationFinishedGoodEvent[]    @relation("OperationFinishedGoodEventCreatedBy")
  operationDispatchEvents     OperationDispatchEvent[]        @relation("OperationDispatchEventCreatedBy")
  operationCommercialEvents   OperationCommercialOrderEvent[] @relation("OperationCommercialOrderEventCreatedBy")
  reviewedOrders              Order[]                         @relation("OrderAdminReview")
  orders                      Order[]
  profile                     Profile?
  account                     Account?                        @relation(fields: [accountId], references: [id])

  @@index([isAdmin])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Profile {
  id                            String               @id @default(cuid())
  accountId                     String?
  userId                        String?              @unique
  firstName                     String
  lastName                      String
  displayNamePublic             String?
  sex                           String?
  bloodType                     String
  allergies                     String               @default("")
  chronicConditions             String               @default("")
  medications                   String               @default("")
  additionalNotes               String               @default("")
  phone                         String?
  profileVisibilityStatus       String               @default("active")
  photoUrl                      String?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  nationalId                    String?              @default("")
  lastScanAt                    DateTime?
  lastScanLocation              String?
  address                       String?
  city                          String?
  birthDate                     DateTime?
  isInsured                     Boolean              @default(false)
  insuranceProvider             String?
  insurancePolicyNumber         String?
  preferredHospital             String?
  insuranceEmergencyPhone       String?
  primaryDoctorName             String?
  primaryDoctorPhone            String?
  showInsuranceProviderPublic   Boolean              @default(false)
  showPreferredHospitalPublic   Boolean              @default(false)
  showPrimaryDoctorPublic       Boolean              @default(false)
  showPrimaryDoctorPhonePublic  Boolean              @default(false)
  showAdditionalNotesPublic     Boolean              @default(false)
  profileType                   String               @default("personal")
  hasCognitiveImpairment        Boolean              @default(false)
  hasWanderingRisk              Boolean              @default(false)
  isNonVerbal                   Boolean              @default(false)
  communicationAssistance       String?
  safeReturnInstructions        String?
  showVulnerabilityStatusPublic Boolean              @default(false)
  showCommunicationStatusPublic Boolean              @default(false)
  showSafeReturnPublic          Boolean              @default(false)
  safeReturnLocationName        String?
  safeReturnAddress             String?
  safeReturnLat                 Float?
  safeReturnLng                 Float?
  safeReturnContactName         String?
  safeReturnContactPhone        String?
  showSafeReturnLocationPublic  Boolean              @default(false)
  assignedChips                 Chip[]
  digitalPass                   DigitalPass?
  orderItems                    OrderItem[]          @relation("OrderItemProfile")
  corporateProfileOf            OrganizationMember?  @relation("CorporateProfileOwner")
  organizationMembers           OrganizationMember[]
  account                       Account?             @relation(fields: [accountId], references: [id])
  user                          User?                @relation(fields: [userId], references: [id])
  contacts                      ProfileContact[]

  @@index([accountId])
  @@index([userId])
}

model Contact {
  id             String           @id @default(cuid())
  userId         String?
  fullName       String
  phone          String
  email          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  notifyEmail    Boolean          @default(true)
  notifySms      Boolean          @default(false)
  notifyWhatsapp Boolean          @default(false)
  relationship   String           @default("Familiar")
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profiles       ProfileContact[]
}

model ProfileContact {
  id             String   @id @default(cuid())
  profileId      String
  contactId      String
  relationship   String
  contactType    String   @default("auxilio")
  priorityOrder  Int      @default(1)
  notifySms      Boolean  @default(false)
  notifyEmail    Boolean  @default(true)
  notifyWhatsapp Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, contactId])
}

model Chip {
  id                  String                       @id @default(cuid())
  shortCode           String                       @unique
  activatedAt         DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  accountId           String?
  assignedProfileId   String?
  batchId             String?
  chipAlias           String?
  chipUidInternal     String                       @unique @default(cuid())
  isPhysical          Boolean                      @default(false)
  lastScanAt          DateTime?
  nfcUrl              String
  nicheType           String                       @default("motorcycle")
  ownerUserId         String?
  productType         String                       @default("sticker_nfc_qr")
  qrUrl               String
  serialPublic        String                       @unique
  serviceEndDate      DateTime?
  serviceStartDate    DateTime?
  serviceStatus       String                       @default("active")
  transferLock        Boolean                      @default(false)
  status              String                       @default("inventory")
  lastScanLocation    String?
  internalLabel       String?                      @unique
  pointOfSaleId       String?
  consignedAt         DateTime?
  account             Account?                     @relation(fields: [accountId], references: [id])
  assignedProfile     Profile?                     @relation(fields: [assignedProfileId], references: [id])
  owner               User?                        @relation(fields: [ownerUserId], references: [id])
  pointOfSale         PointOfSale?                 @relation(fields: [pointOfSaleId], references: [id])
  claimTokens         ChipClaimToken[]
  corporateOrderItems CorporateOrderEmployeeItem[]
  notifications       Notification[]
  orderItems          OrderItem[]                  @relation("OrderItemChip")
  scanEvents          ScanEvent[]

  @@index([accountId])
  @@index([ownerUserId])
  @@index([status])
  @@index([serviceEndDate])
  @@index([pointOfSaleId])
}

model PointOfSale {
  id           String   @id @default(cuid())
  name         String   @unique
  address      String?
  contactName  String?
  contactPhone String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  chips        Chip[]

  @@index([isActive])
}

model Organization {
  id                    String                    @id @default(cuid())
  accountId             String
  legalName             String
  displayName           String?
  organizationType      String                    @default("company")
  taxId                 String?
  contactEmail          String?
  contactPhone          String?
  address               String?
  status                String                    @default("active")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  emergencyButton1Label String?                   @default("Brigada Interna")
  emergencyButton1Phone String?
  emergencyButton2Label String?                   @default("Seguridad Control")
  emergencyButton2Phone String?
  emergencyButton3Label String?                   @default("Ambulancia / Clínica")
  emergencyButton3Phone String?
  companyCode           String?                   @unique
  productRequests       CorporateProductRequest[]
  publicProfile         CorporatePublicProfile?
  orders                Order[]
  account               Account                   @relation(fields: [accountId], references: [id])
  locations             OrganizationLocation[]
  members               OrganizationMember[]
}

model CorporatePublicProfile {
  id                        String       @id @default(cuid())
  organizationId            String       @unique
  shortCode                 String       @unique
  status                    String       @default("draft")
  logoUrl                   String?
  displayName               String?
  legalName                 String?
  ruc                       String?
  foundedYear               Int?
  industry                  String?
  description               String?
  slogan                    String?
  phone                     String?
  whatsapp                  String?
  email                     String?
  website                   String?
  address                   String?
  mapUrl                    String?
  businessHours             String?
  instagram                 String?
  facebook                  String?
  linkedin                  String?
  tiktok                    String?
  xTwitter                  String?
  youtube                   String?
  mainServices              String?
  mainProducts              String?
  branches                  String?
  contactPerson             String?
  contactDepartment         String?
  certifications            String?
  licenses                  String?
  operationNotice           String?
  securityContactName       String?
  securityPhone             String?
  emergencyProcedure        String?
  meetingPoint              String?
  receptionPhone            String?
  corporateWhatsapp         String?
  customEmployeeMessage     String?
  showCompanyCode           Boolean      @default(false)
  showLogo                  Boolean      @default(true)
  showDisplayName           Boolean      @default(true)
  showLegalName             Boolean      @default(false)
  showRuc                   Boolean      @default(false)
  showFoundedYear           Boolean      @default(false)
  showIndustry              Boolean      @default(true)
  showDescription           Boolean      @default(true)
  showSlogan                Boolean      @default(true)
  showPhone                 Boolean      @default(false)
  showWhatsapp              Boolean      @default(false)
  showEmail                 Boolean      @default(false)
  showWebsite               Boolean      @default(false)
  showAddress               Boolean      @default(false)
  showMapUrl                Boolean      @default(false)
  showBusinessHours         Boolean      @default(false)
  showInstagram             Boolean      @default(false)
  showFacebook              Boolean      @default(false)
  showLinkedin              Boolean      @default(false)
  showTiktok                Boolean      @default(false)
  showXTwitter              Boolean      @default(false)
  showYoutube               Boolean      @default(false)
  showMainServices          Boolean      @default(false)
  showMainProducts          Boolean      @default(false)
  showBranches              Boolean      @default(false)
  showContactPerson         Boolean      @default(false)
  showContactDepartment     Boolean      @default(false)
  showCertifications        Boolean      @default(false)
  showLicenses              Boolean      @default(false)
  showOperationNotice       Boolean      @default(false)
  showSecurityContactName   Boolean      @default(false)
  showSecurityPhone         Boolean      @default(false)
  showEmergencyProcedure    Boolean      @default(false)
  showMeetingPoint          Boolean      @default(false)
  showReceptionPhone        Boolean      @default(false)
  showCorporateWhatsapp     Boolean      @default(false)
  showCustomEmployeeMessage Boolean      @default(true)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationLocation {
  id             String                   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  city           String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @default(now()) @updatedAt
  departments    OrganizationDepartment[]
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members        OrganizationMember[]
}

model OrganizationDepartment {
  id         String               @id @default(cuid())
  locationId String
  name       String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @default(now()) @updatedAt
  location   OrganizationLocation @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members    OrganizationMember[]
}

model OrganizationMember {
  id                  String                       @id @default(cuid())
  organizationId      String
  profileId           String
  internalCode        String?
  department          String?
  position            String?
  memberStatus        String                       @default("active")
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  locationId          String?
  departmentId        String?
  employeeId          String?
  shift               String?
  occupationalRisks   String[]                     @default([])
  medicalRestrictions String?
  emergencyProtocol   String?
  supervisorName      String?
  supervisorPhone     String?
  corporateStatus     String                       @default("pending_company_review")
  employeeNationalId  String?
  employeeAge         Int?
  employeePhone       String?
  employeePosition    String?
  employeeDepartment  String?
  employeeInternalId  String?
  employeeNote        String?
  corporateProfileId  String?                      @unique
  corporateOrderItems CorporateOrderEmployeeItem[]
  productRequests     CorporateProductRequest[]
  corporateProfile    Profile?                     @relation("CorporateProfileOwner", fields: [corporateProfileId], references: [id])
  departmentRel       OrganizationDepartment?      @relation(fields: [departmentId], references: [id], onUpdate: NoAction)
  location            OrganizationLocation?        @relation(fields: [locationId], references: [id], onUpdate: NoAction)
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile             Profile                      @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ChipClaimToken {
  id             String    @id @default(cuid())
  chipId         String
  activationCode String    @unique
  expiresAt      DateTime?
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  orderId        String?
  status         String    @default("active")
  chip           Chip      @relation(fields: [chipId], references: [id], onDelete: Cascade)
  order          Order?    @relation(fields: [orderId], references: [id])
}

model ScanEvent {
  id                 String   @id @default(cuid())
  chipId             String
  profileId          String?
  accountId          String?
  scannedAt          DateTime @default(now())
  sourceType         String   @default("qr")
  ipAddress          String?
  userAgent          String?
  geoLat             Float?
  geoLng             Float?
  geoAccuracy        Float?
  country            String?
  city               String?
  address            String?
  emergencyMode      Boolean  @default(true)
  notificationStatus String   @default("pending")
  rawMetadataJson    String?
  chip               Chip     @relation(fields: [chipId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([chipId])
  @@index([scannedAt])
  @@index([country])
  @@index([city])
}

model Consent {
  id           String    @id @default(cuid())
  accountId    String?
  userId       String?
  profileId    String?
  consentType  String
  textVersion  String
  grantedAt    DateTime  @default(now())
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  evidenceJson String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String   @id @default(cuid())
  accountId     String?
  actorUserId   String?
  entityType    String
  entityId      String
  action        String
  oldValuesJson String?
  newValuesJson String?
  createdAt     DateTime @default(now())

  @@index([accountId])
  @@index([entityId])
  @@index([createdAt])
}

model Notification {
  id               String    @id @default(cuid())
  chipId           String
  eventId          String
  channel          String
  recipient        String
  status           String    @default("pending")
  providerResponse String?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  chip             Chip      @relation(fields: [chipId], references: [id], onDelete: Cascade)

  @@index([chipId])
  @@index([status])
}

model Order {
  id                      String                       @id @default(cuid())
  userId                  String?
  amount                  Float
  currency                String                       @default("USD")
  paymentStatus           String                       @default("pending")
  provider                String                       @default("manual")
  providerReference       String?
  createdAt               DateTime                     @default(now())
  customerDocument        String?
  customerEmail           String?
  customerName            String?
  customerPhone           String?
  orderNumber             String                       @unique @default(cuid())
  orderStatus             String                       @default("pending")
  paymentProofUrl         String?
  updatedAt               DateTime                     @updatedAt
  shippingAddress         String?
  shippingCity            String?
  shippingNotes           String?
  packageId               String?
  manualPaymentReference  String?
  paymentMethod           String                       @default("manual")
  adminReviewStatus       String                       @default("pending")
  adminReviewedAt         DateTime?
  adminReviewedById       String?
  adminReviewNotes        String?
  organizationId          String?
  orderType               String                       @default("manual")
  corporateDeliveryStatus String                       @default("preparation_pending")
  estimatedDeliveryDate   DateTime?
  deliveryNote            String?
  chipClaimTokens         ChipClaimToken[]
  corporateEmployeeItems  CorporateOrderEmployeeItem[]
  productRequests         CorporateProductRequest[]
  adminReviewedBy         User?                        @relation("OrderAdminReview", fields: [adminReviewedById], references: [id])
  organization            Organization?                @relation(fields: [organizationId], references: [id])
  package                 Package?                     @relation(fields: [packageId], references: [id])
  user                    User?                        @relation(fields: [userId], references: [id])
  items                   OrderItem[]

  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([packageId])
  @@index([organizationId])
  @@index([orderType])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productType String
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profileId   String?
  chipId      String?
  chip        Chip?    @relation("OrderItemChip", fields: [chipId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  profile     Profile? @relation("OrderItemProfile", fields: [profileId], references: [id])

  @@index([orderId])
  @@index([profileId])
  @@index([chipId])
}

model CorporateOrderEmployeeItem {
  id                   String             @id @default(cuid())
  orderId              String
  organizationMemberId String
  productId            String
  quantity             Int                @default(1)
  unitPrice            Float
  subtotal             Float
  createdAt            DateTime           @default(now())
  chipId               String?
  fulfillmentStatus    String             @default("pending_assignment")
  activatedAt          DateTime?
  deliveryStatus       String?            @default("pending")
  deliveredAt          DateTime?
  deliveredByUserId    String?
  receivedByUserId     String?
  deliveryEvidenceUrl  String?
  deliveryNote         String?
  chip                 Chip?              @relation(fields: [chipId], references: [id])
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organizationMember   OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  product              Product            @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([organizationMemberId])
  @@index([productId])
  @@index([chipId])
  @@index([fulfillmentStatus])
  @@index([deliveryStatus])
}

model CorporateProductRequest {
  id                   String                        @id @default(cuid())
  organizationId       String
  organizationMemberId String
  requestedByUserId    String
  status               String                        @default("pending_company_approval")
  companyReviewedAt    DateTime?
  companyReviewedById  String?
  rejectionReason      String?
  orderId              String?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  companyReviewedBy    User?                         @relation("CorporateProductRequestReviewedBy", fields: [companyReviewedById], references: [id])
  order                Order?                        @relation(fields: [orderId], references: [id])
  organization         Organization                  @relation(fields: [organizationId], references: [id])
  organizationMember   OrganizationMember            @relation(fields: [organizationMemberId], references: [id])
  requestedBy          User                          @relation("CorporateProductRequestRequestedBy", fields: [requestedByUserId], references: [id])
  items                CorporateProductRequestItem[]

  @@index([organizationId])
  @@index([organizationMemberId])
  @@index([requestedByUserId])
  @@index([status])
}

model CorporateProductRequestItem {
  id        String                  @id @default(cuid())
  requestId String
  productId String
  quantity  Int                     @default(1)
  unitPrice Float
  subtotal  Float
  note      String?
  createdAt DateTime                @default(now())
  product   Product                 @relation(fields: [productId], references: [id])
  request   CorporateProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([productId])
}

model DigitalPass {
  id           String   @id @default(cuid())
  profileId    String   @unique
  passType     String
  passUrl      String?
  serialNumber String?  @unique
  authToken    String?
  lastUpdate   DateTime @default(now())
  createdAt    DateTime @default(now())
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model AppNotification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String    @id
  email        String    @unique
  passwordHash String
  role         String    @default("admin")
  createdAt    DateTime  @default(now())
  status       String    @default("active")
  name         String?
  updatedAt    DateTime?
}

model OperationMaterial {
  id              String                         @id @default(cuid())
  code            String                         @unique
  name            String
  description     String?
  category        String
  unit            String
  status          String                         @default("active")
  supplierName    String?
  notes           String?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  events          OperationMaterialEvent[]
  productionItems OperationProductionOrderItem[]

  @@index([category])
  @@index([status])
  @@index([createdAt])
}

model OperationMaterialEvent {
  id            String            @id @default(cuid())
  materialId    String
  eventType     String
  quantity      Float
  unit          String
  reason        String?
  referenceType String?
  referenceId   String?
  metadataJson  String?
  createdById   String?
  createdAt     DateTime          @default(now())
  createdBy     User?             @relation("OperationMaterialEventCreatedBy", fields: [createdById], references: [id])
  material      OperationMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([eventType])
  @@index([createdById])
  @@index([createdAt])
}

model OperationProductionOrder {
  id               String                         @id @default(cuid())
  code             String                         @unique
  title            String
  status           String                         @default("draft")
  plannedQuantity  Float
  producedQuantity Float                          @default(0)
  outputType       String
  notes            String?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  items            OperationProductionOrderItem[]
  events           OperationProductionEvent[]
  qcInspections    OperationQcInspection[]
  packingBatches   OperationPackingBatch[]

  @@index([status])
  @@index([outputType])
  @@index([createdAt])
}

model OperationProductionOrderItem {
  id                String                   @id @default(cuid())
  productionOrderId String
  materialId        String
  plannedQuantity   Float
  consumedQuantity  Float                    @default(0)
  unit              String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  material          OperationMaterial        @relation(fields: [materialId], references: [id])
  productionOrder   OperationProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@index([materialId])
}

model OperationProductionEvent {
  id                String                   @id @default(cuid())
  productionOrderId String
  eventType         String
  quantity          Float?
  reason            String?
  metadataJson      String?
  createdById       String?
  createdAt         DateTime                 @default(now())
  createdBy         User?                    @relation("OperationProductionEventCreatedBy", fields: [createdById], references: [id])
  productionOrder   OperationProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@index([eventType])
  @@index([createdById])
  @@index([createdAt])
}

model OperationQcInspection {
  id                String                       @id @default(cuid())
  code              String                       @unique
  productionOrderId String?
  status            String                       @default("pending")
  inspectionType    String                       @default("standard")
  inspectedQuantity Int                          @default(0)
  passedQuantity    Int                          @default(0)
  failedQuantity    Int                          @default(0)
  notes             String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  events            OperationQcInspectionEvent[]
  productionOrder   OperationProductionOrder?    @relation(fields: [productionOrderId], references: [id])
  packingBatches    OperationPackingBatch[]

  @@index([productionOrderId])
  @@index([status])
  @@index([inspectionType])
  @@index([createdAt])
}

model OperationQcInspectionEvent {
  id             String                @id @default(cuid())
  qcInspectionId String
  eventType      String
  quantity       Int?
  passedQuantity Int?
  failedQuantity Int?
  reason         String?
  metadataJson   String?
  createdById    String?
  createdAt      DateTime              @default(now())
  createdBy      User?                 @relation("OperationQcInspectionEventCreatedBy", fields: [createdById], references: [id])
  qcInspection   OperationQcInspection @relation(fields: [qcInspectionId], references: [id], onDelete: Cascade)

  @@index([qcInspectionId])
  @@index([eventType])
  @@index([createdById])
  @@index([createdAt])
}

model OperationPackingBatch {
  id                String                    @id @default(cuid())
  code              String                    @unique
  productionOrderId String?
  qcInspectionId    String?
  status            String                    @default("draft")
  packageType       String                    @default("standard")
  plannedQuantity   Int                       @default(0)
  packedQuantity    Int                       @default(0)
  rejectedQuantity  Int                       @default(0)
  labelCode         String?
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  events            OperationPackingEvent[]
  finishedGoods     OperationFinishedGood[]
  productionOrder   OperationProductionOrder? @relation(fields: [productionOrderId], references: [id])
  qcInspection      OperationQcInspection?    @relation(fields: [qcInspectionId], references: [id])

  @@index([productionOrderId])
  @@index([qcInspectionId])
  @@index([status])
  @@index([packageType])
  @@index([createdAt])
}

model OperationPackingEvent {
  id             String                @id @default(cuid())
  packingBatchId String
  eventType      String
  quantity       Int?
  reason         String?
  metadataJson   String?
  createdById    String?
  createdAt      DateTime              @default(now())
  createdBy      User?                 @relation("OperationPackingEventCreatedBy", fields: [createdById], references: [id])
  packingBatch   OperationPackingBatch @relation(fields: [packingBatchId], references: [id], onDelete: Cascade)

  @@index([packingBatchId])
  @@index([eventType])
  @@index([createdById])
  @@index([createdAt])
}

model OperationFinishedGood {
  id              String                         @id @default(cuid())
  code            String                         @unique
  name            String
  productType     String
  status          String                         @default("active")
  unit            String                         @default("unit")
  packingBatchId  String?
  notes           String?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  events          OperationFinishedGoodEvent[]
  dispatchItems   OperationDispatchItem[]
  commercialItems OperationCommercialOrderItem[]
  packingBatch    OperationPackingBatch?         @relation(fields: [packingBatchId], references: [id])

  @@index([packingBatchId])
  @@index([status])
  @@index([productType])
  @@index([createdAt])
}

model OperationFinishedGoodEvent {
  id             String                @id @default(cuid())
  finishedGoodId String
  eventType      String
  quantity       Float
  unit           String
  reason         String?
  referenceType  String?
  referenceId    String?
  metadataJson   String?
  createdById    String?
  createdAt      DateTime              @default(now())
  createdBy      User?                 @relation("OperationFinishedGoodEventCreatedBy", fields: [createdById], references: [id])
  finishedGood   OperationFinishedGood @relation(fields: [finishedGoodId], references: [id], onDelete: Cascade)

  @@index([finishedGoodId])
  @@index([eventType])
  @@index([createdById])
  @@index([createdAt])
}

model OperationDispatch {
  id                   String                     @id @default(cuid())
  code                 String                     @unique
  status               String                     @default("draft")
  destinationType      String                     @default("customer")
  destinationName      String?
  destinationReference String?
  destinationAddress   String?
  scheduledAt          DateTime?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  notes                String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  items                OperationDispatchItem[]
  events               OperationDispatchEvent[]
  commercialOrders     OperationCommercialOrder[]

  @@index([status])
  @@index([destinationType])
  @@index([createdAt])
}

model OperationDispatchItem {
  id             String                @id @default(cuid())
  dispatchId     String
  finishedGoodId String
  quantity       Float
  unit           String
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  dispatch       OperationDispatch     @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  finishedGood   OperationFinishedGood @relation(fields: [finishedGoodId], references: [id])

  @@index([dispatchId])
  @@index([finishedGoodId])
}

model OperationDispatchEvent {
  id            String            @id @default(cuid())
  dispatchId    String
  eventType     String
  quantity      Float?
  reason        String?
  referenceType String?
  referenceId   String?
  metadataJson  String?
  createdById   String?
  createdAt     DateTime          @default(now())
  createdBy     User?             @relation("OperationDispatchEventCreatedBy", fields: [createdById], references: [id])
  dispatch      OperationDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([dispatchId])
  @@index([eventType])
  @@index([createdById])
  @@index([createdAt])
}

model OperationCommercialOrder {
  id                String                          @id @default(cuid())
  code              String                          @unique
  status            String                          @default("draft")
  customerType      String                          @default("customer")
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  customerReference String?
  salesChannel      String                          @default("admin")
  paymentStatus     String                          @default("pending")
  fulfillmentStatus String                          @default("pending")
  totalAmount       Float                           @default(0)
  currency          String                          @default("USD")
  dispatchId        String?
  notes             String?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  dispatch          OperationDispatch?              @relation(fields: [dispatchId], references: [id])
  items             OperationCommercialOrderItem[]
  events            OperationCommercialOrderEvent[]

  @@index([status])
  @@index([customerType])
  @@index([salesChannel])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([dispatchId])
  @@index([createdAt])
}

model OperationCommercialOrderItem {
  id                String                   @id @default(cuid())
  commercialOrderId String
  finishedGoodId    String?
  productCode       String?
  productName       String
  quantity          Float
  unitPrice         Float
  totalPrice        Float
  unit              String                   @default("unit")
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  commercialOrder   OperationCommercialOrder @relation(fields: [commercialOrderId], references: [id], onDelete: Cascade)
  finishedGood      OperationFinishedGood?   @relation(fields: [finishedGoodId], references: [id])

  @@index([commercialOrderId])
  @@index([finishedGoodId])
  @@index([productCode])
}

model OperationCommercialOrderEvent {
  id                String                   @id @default(cuid())
  commercialOrderId String
  eventType         String
  amount            Float?
  reason            String?
  referenceType     String?
  referenceId       String?
  metadataJson      String?
  createdById       String?
  createdAt         DateTime                 @default(now())
  commercialOrder   OperationCommercialOrder @relation(fields: [commercialOrderId], references: [id], onDelete: Cascade)
  createdBy         User?                    @relation("OperationCommercialOrderEventCreatedBy", fields: [createdById], references: [id])

  @@index([commercialOrderId])
  @@index([eventType])
  @@index([createdById])
  @@index([createdAt])
}
