# Public app URLs
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth
NEXTAUTH_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-32-byte-or-long-random-key

# Database / Prisma
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@host:5432/database

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Scheduled jobs
CRON_SECRET=replace-with-cron-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace

# Email
RESEND_API_KEY=re_replace

# SMS / WhatsApp
TWILIO_ACCOUNT_SID=AC_replace
TWILIO_AUTH_TOKEN=replace-with-token
TWILIO_PHONE_NUMBER=+10000000000
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000

# Optional distributed rate limit
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-token
