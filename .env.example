# Canonical URLs
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication and encryption
NEXTAUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ENCRYPTION_KEY=replace-with-64-hex-chars-or-an-exact-32-byte-key

# Database / Prisma
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@host:5432/database

# Test database — must never point to production
DATABASE_URL_TEST=postgresql://user:password@host:5432/prerescate_test

# Supabase server storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Script-only aliases used by maintenance/audit tooling
APP_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co

# Scheduled jobs
CRON_SECRET=replace-with-a-long-random-cron-secret

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Yappy Boton de Pago V2 (optional)
# Use uat until Banco General/Yappy approves the production button.
YAPPY_ENVIRONMENT=uat
YAPPY_MERCHANT_ID=
YAPPY_SECRET_KEY=
YAPPY_DOMAIN=http://localhost:3000

# Email / Resend (optional; configure both together)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS / WhatsApp / Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WHATSAPP_FROM=

# Distributed rate limit / Upstash (required in production)
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
